"use client";

import { useState, useEffect } from "react";
import { Search, Filter, ExternalLink, CheckCircle, Clock, Circle } from "lucide-react";

interface Product {
  id: number;
  product_id: string;
  product_name: string;
  thumbnail_url?: string;
  source: string;
  sourcing_price: number;
  market_price: number;
  expected_profit?: number;
  profit_margin_rate?: number;
  discount_rate?: number | null;
  original_product_link?: string;
  collected_at: string;
  status: "검토중" | "소싱완료" | "보류";
  memo?: string;
}

interface FilterState {
  min_profit_margin: number | "";
  search_query: string;
  sort_by: "profit_margin_rate" | "discount_rate" | "collected_at";
  sort_order: "asc" | "desc";
}

const API_URL = process.env.NEXT_PUBLIC_API_URL || "http://localhost:8000/api";

export default function Home() {
  const [products, setProducts] = useState<Product[]>([]);
  const [loading, setLoading] = useState(false);
  const [filterState]: FilterState = { min_profit_margin: "", search_query: "", sort_by: "collected_at", sort_order: "desc" };

  useEffect(() => { fetchProducts(); }, [filterState]);

  const fetchProducts = async () => {
    setLoading(true);
    try {
      let url = `${API_URL}/products?sort_by=${filterState.sort_by}&sort_order=${filterState.sort_order}`;
      if (filterState.min_profit_margin) url += `&min_profit_margin=${filterState.min_profit_margin}`;
      if (filterState.search_query) url += `&search_query=${encodeURIComponent(filterState.search_query)}`;
      const response = await fetch(url);
      setProducts(await response.json());
    } catch (error) { console.error("상품 조회 실패:", error); } finally { setLoading(false); }
  };

  const handleStatusChange = async (id: number, newStatus: string) => {
    try {
      await fetch(`${API_URL}/products/${id}`, { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ status: newStatus }) });
      fetchProducts();
    } catch (error) { console.error("상태 업데이트 실패:", error); }
  };

  const getStatusIcon = (status: string) => {
    switch (status) {
      case "검토중": return <Clock className="w-4 h-4 text-yellow-500" />;
      case "소싱완료": return <CheckCircle className="w-4 h-4 text-green-500" />;
      case "보류": return <Circle className="w-4 h-4 text-gray-400" />;
    }
  };

  const getStatusColor = (status: string) => {
    switch (status) {
      case "검토중": return "bg-yellow-100 text-yellow-800";
      case "소싱완료": return "bg-green-100 text-green-800";
      case "보류": return "bg-gray-100 text-gray-800";
    }
  };

  const getMarginColor = (rate: number | undefined) => {
    if (!rate) return "";
    return rate >= 50 ? "bg-green-100 text-green-800" : rate >= 30 ? "bg-yellow-100 text-yellow-800" : "bg-red-100 text-red-800";
  return (
    <div className="min-h-screen bg-gray-50">
      <header className="bg-white shadow-sm border-b sticky top-0 z-10">
        <div className="max-w-7xl mx-auto px-4 py-4">
          <div className="flex flex-col md:flex-row gap-4 items-center justify-between">
            <div className="flex flex-wrap gap-3 w-full md:w-auto">
              <div>
                <label className="text-sm text-gray-600 block mb-1">마진율: {filterState.min_profit_margin || "전체"}</label>
                <input type="range" min="0" max="100" value={Number(filterState.min_profit_margin) || 0} onChange={(e) => setFilterState({ ...filterState, min_profit_margin: Number(e.target.value) })} className="w-48 h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600" />
              </div>
              <div className="relative">
                <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" />
                <input type="text" placeholder="상품명/소싱처 검색..." value={filterState.search_query} onChange={(e) => setFilterState({ ...filterState, search_query: e.target.value })} className="pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 w-full md:w-64" />
              </div>
              <select value={filterState.sort_by} onChange={(e) => setFilterState({ ...filterState, sort_by: e.target.value as any })} className="px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="profit_margin_rate">마진율순</option>
                <option value="discount_rate">할인율순</option>
                <option value="collected_at">최신순</option>
              </select>
              <select value={filterState.sort_order} onChange={(e) => setFilterState({ ...filterState, sort_order: e.target.value as any })} className="px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="desc">내림차순</option>
                <option value="asc">오름차순</option>
              </select>
              <button onClick={() => setFilterState({ min_profit_margin: "", search_query: "", sort_by: "collected_at", sort_order: "desc" })} className="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors">초기화</button>
              <a href={`${API_URL}/mock-seed`} target="_blank" rel="noopener noreferrer" className="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 transition-colors flex items-center gap-2"><Filter className="w-4 h-4" />가상데이터 생성</a>
            </div>
            <h1 className="text-xl font-bold text-gray-800">소싱 상품 대시보드</h1>
          </div>
        </div>
      </header>

      <main className="max-w-7xl mx-auto px-4 py-6">
        {loading ? (
          <div className="text-center py-20"><p className="text-gray-500">상품 목록을 불러오는 중...</p></div>
        ) : products.length === 0 ? (
          <div className="text-center py-20 bg-white rounded-lg shadow-sm border">
            <Filter className="w-16 h-16 text-gray-300 mx-auto mb-4" />
            <p className="text-gray-500 text-lg">상품이 없습니다.</p>
            <a href={`${API_URL}/mock-seed`} target="_blank" rel="noopener noreferrer" className="mt-4 inline-block px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">가상 데이터 생성하기</a>
          </div>
        ) : (
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {products.map((product) => (
              <ProductCard key={product.id} product={product} onStatusChange={handleStatusChange} />
            ))}
          </div>
        )}
        <div className="mt-8 flex justify-center"><p className="text-sm text-gray-500">{products.length}개 상품 조회 중</p></div>
      </main>
    </div>
  );
}

function ProductCard({ product, onStatusChange }: { product: Product; onStatusChange: (id: number, status: string) => void }) {
  return (
    <div className="bg-white rounded-lg shadow-sm border hover:shadow-md transition-shadow overflow-hidden group">
      <div className="relative h-48 bg-gray-200 overflow-hidden">
        {product.thumbnail_url ? (<img src={product.thumbnail_url} alt={product.product_name} className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />) : (<div className="w-full h-full flex items-center justify-center text-gray-400"><span className="text-sm">{product.product_name}</span></div>)}
      <div className="p-4">
        <h3 className="font-semibold text-gray-800 truncate" title={product.product_name}>{product.product_name}</h3>
        <p className="text-sm text-gray-500 mt-1">{product.source}</p>
        <div className="mt-3 space-y-1">
          <div className="flex justify-between items-center text-sm"><span className="text-gray-600">소싱가:</span><span className="font-medium">{product.sourcing_price.toLocaleString()}원</span></div>
          <div className="flex justify-between items-center text-sm"><span className="text-gray-600">시중가:</span><span className="font-bold text-blue-600">{product.market_price.toLocaleString()}원</span></div>
        </div>
        {product.profit_margin_rate && (<div className={`mt-2 px-2 py-1 rounded text-sm font-bold ${getMarginColor(product.profit_margin_rate)}`}>마진율: {product.profit_margin_rate}%</div>)}
        {product.discount_rate && (<div className="mt-1 px-2 py-1 rounded text-sm bg-gray-100 text-gray-700">할인율: {product.discount_rate}%</div>)}
        <select value={product.status} onChange={(e) => onStatusChange(product.id, e.target.value)} className="mt-3 w-full px-2 py-1.5 text-sm border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="검토중">검토중</option>
          <option value="소싱완료">소싱완료</option>
          <option value="보류">보류</option>
        </select>
        {product.memo && (<div className="mt-2 p-2 bg-gray-50 rounded text-xs text-gray-600 truncate">{product.memo}</div>)}
      </div>
    </div>
  );
}

        {product.original_product_link && (<a href={product.original_product_link} target="_blank" rel="noopener noreferrer" className="absolute top-2 right-2 p-1.5 bg-white rounded-full shadow-md hover:bg-gray-50 transition-colors" title="원본 링크 보기"><ExternalLink className="w-4 h-4 text-gray-600" /></a>)}
        <div className={`absolute top-2 left-2 px-2 py-1 rounded-full text-xs font-medium ${getStatusColor(product.status)}`}>{product.status}{getStatusIcon(product.status)}</div>
      </div>
  };

